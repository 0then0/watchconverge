{
  "version": 1,
  "repetitions": 3,
  "deadlines": {
    "readyTimeoutMs": 5000,
    "requestTimeoutMs": 1500,
    "windowMs": 1200,
    "pollMs": 80
  },
  "modes": ["watched", "no-watch"],
  "scenarios": ["create", "delete", "directory-rename", "recreate"],
  "create": {
    "version": 1,
    "id": "create",
    "name": "Create file",
    "description": "An added file must appear in the existing file index.",
    "initial": [{ "path": "keep.txt", "content": "keep\n" }],
    "steps": [
      {
        "name": "Create new.txt",
        "operations": [{ "kind": "write", "path": "new.txt", "content": "new\n" }]
      }
    ]
  }
}

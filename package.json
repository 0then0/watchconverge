{
  "name": "watchconverge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compare a watcher consumer's existing index with independent disk snapshots.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0then0/watchconverge.git"
  },
  "homepage": "https://github.com/0then0/watchconverge#readme",
  "bugs": {
    "url": "https://github.com/0then0/watchconverge/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node src/server.ts --dev",
    "start": "node src/server.ts",
    "cli": "node src/cli.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "node --test tests/*.test.ts",
    "test:ui": "playwright test",
    "validate": "npm run check && npm run build && npm test && npm run test:ui"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
